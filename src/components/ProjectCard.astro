---
import Git from "@/icons/git.astro";

export interface Props {
	url: string;
	description: string;
	highlights: string[];
	name: string;
	isActive: boolean;
	github?: string;
	headingLevel?: 3 | 4;
}

const { url, description, highlights, name, github, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const showRepoLink = github && github !== url;
---

<article class="group relative flex h-full flex-col rounded-lg bg-skin-button-muted/50 p-5 shadow-sm ring-1 ring-skin-muted transition focus-within:ring-2 focus-within:ring-skin-hue hover:ring-skin-hue/60">
	<header class="flex items-start justify-between gap-3">
		<Heading class="flex min-w-0 items-center gap-2 text-lg leading-snug">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-skin-hue" aria-hidden="true">
				<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
			</svg>
			<a href={url} target="_blank" rel="noopener noreferrer" class="break-words outline-none after:absolute after:inset-0 after:rounded-lg after:content-[''] group-hover:text-skin-hue">
				{name}
				<span class="sr-only">(se abre en una pestaña nueva)</span>
			</a>
		</Heading>

		{
			showRepoLink && (
				<a href={github} target="_blank" rel="noopener noreferrer" class="relative z-10 -m-2 inline-flex size-10 shrink-0 items-center justify-center rounded-md text-skin-muted transition-colors hover:text-skin-hue focus-visible:outline focus-visible:outline-2 focus-visible:outline-skin-hue" aria-label={`Código de ${name} en GitHub`} title="Ver código en GitHub">
					<Git />
				</a>
			)
		}
	</header>

	<p class="mt-3 text-sm text-skin-base">{description}</p>

	{
		highlights.length > 0 && (
			<ul class="mt-3 ml-4 list-disc space-y-1 text-sm text-skin-muted marker:text-skin-hue">
				{highlights.map((highlight) => (
					<li>{highlight}</li>
				))}
			</ul>
		)
	}
</article>
