---
import "hotkeypad/index.css";
import { type SocialIcon } from "@/types";
import { basics } from "@cv";

const { profiles } = basics;

const SOCIAL_ICONS: SocialIcon = {
	GitHub: `<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><path
    fill="currentColor"
    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
  ></path></svg
>`,
	LinkedIn: `<svg
  height="16"
  width="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><title>LinkedIn</title><path
    fill="currentColor"
    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
  ></path></svg
>`,
	X: `<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><title>X</title><path
    fill="currentColor"
    d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
  ></path></svg
>
`,
};

const profilesInfo = profiles.map(({ network, url }) => {
	const icon = SOCIAL_ICONS[network];
	const firstLetter = network[0].toUpperCase();

	return {
		id: network,
		section: "Redes",
		title: `Visitar ${network}`,
		url,
		icon,
		hotkey: `ctrl+${firstLetter}`,
	};
});
---

<aside class="kb-hint no-print" aria-label="Atajo de teclado">
	<p>Pulsa <kbd data-mod-key>Ctrl</kbd> + <kbd>K</kbd> para abrir la paleta de comandos.</p>
</aside>

<button type="button" class="footer-button kb-fab no-print" aria-label="Abrir paleta de comandos">
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"></path>
	</svg>
</button>

<div id="hotkeypad" data-placeholder="Buscar comando" data-info={JSON.stringify(profilesInfo)}></div>

<template id="hotkeypad-footer">
	<p><kbd>↩</kbd> para seleccionar</p>
	<p><kbd>↑</kbd><kbd>↓</kbd> para navegar</p>
	<p><kbd data-mod-key>Ctrl</kbd><kbd>K</kbd><kbd>Esc</kbd> para cerrar</p>
</template>

<script>
	interface Info {
		id: string;
		section: string;
		title: string;
		url: string;
		icon: string;
		hotkey: string;
		handler?: () => void;
	}

	import HotKeyPad from "hotkeypad";

	const hotkeypad = new HotKeyPad({ emptyMessage: "No se encontraron comandos" });
	const info = hotkeypad.instance.getAttribute("data-info") ?? "[]";
	const parsedInfo = JSON.parse(info) as Info[];

	const data = parsedInfo.map(({ url, hotkey, icon, id, section, title }) => {
		return {
			id,
			title,
			icon,
			hotkey,
			section,
			handler: () => {
				window.open(url, "_blank", "noopener,noreferrer");
			},
		};
	});
	hotkeypad.setCommands([
		{
			id: "print",
			title: "Imprimir CV",
			icon: `<svg style="margin-right: 8px" width="16" height="16" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
  <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
</svg>`,
			hotkey: "ctrl+P",
			section: "Acciones",
			handler: () => {
				window.print();
			},
		},
		...data,
	]);

	document.querySelectorAll(".footer-button").forEach((button) => {
		button.addEventListener("click", () => {
			document.dispatchEvent(new KeyboardEvent("keydown", { key: "K", code: "KeyK", ctrlKey: true }));
		});
	});

	if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
		document.querySelectorAll("[data-mod-key]").forEach((el) => (el.textContent = "⌘"));
	}
</script>

<style>
	@reference "../styles/global.css";

	.kb-hint {
		@apply mx-auto max-w-7xl px-5 pb-10 text-center;
	}

	.kb-hint p {
		@apply text-xs;
	}

	.kb-hint kbd {
		@apply rounded-sm border border-skin-muted bg-skin-button-muted px-1.5 py-0.5 font-mono text-[0.7rem] text-skin-base;
	}

	.kb-fab {
		@apply fixed z-40 hidden size-12 items-center justify-center rounded-full bg-skin-fill text-skin-hue shadow-lg ring-1 ring-skin-muted transition-colors hover:bg-skin-button-accent hover:text-skin-inverted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
	}

	/* Touch devices: no keyboard shortcut, show a floating trigger instead. */
	@media (max-width: 639px), (hover: none) {
		.kb-hint {
			@apply hidden;
		}

		.kb-fab {
			@apply flex;
		}

		:global(#hotkeypad [data-hotkey] div),
		:global(#hotkeypad footer) {
			display: none;
		}
	}

	/*
	 * hotkeypad declares `width: fit-content` followed by `width: -moz-fit-content`; Vite 8's
	 * CSS minifier keeps only the prefixed value, which Chromium ignores, squashing the kbd chips.
	 */
	:global(#hotkeypad [data-container] header span),
	:global(#hotkeypad [data-hotkey] div span) {
		width: fit-content;
	}

	#hotkeypad {
		--hotkeypad-bg-kbd: rgb(var(--color-button-muted));
		--hotkeypad-bg-backdrop: rgb(var(--color-text-base));
		--hotkeypad-bg-container: rgb(var(--color-fill));
		--hotkeypad-bg-item-hover: rgba(var(--color), 0.12);
		--hotkeypad-border-container: rgb(var(--muted));
		--hotkeypad-border-container-hover: rgb(var(--color));
		--hotkeypad-fg-muted: rgb(var(--color-text-base));
	}
</style>
