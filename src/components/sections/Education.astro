---
import Section from "../Section.astro";
import { education, certificates } from "@cv";
import { yearOf } from "@/lib/date";

const icons: Record<string, string> = {
  python: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3"/><path d="M15 5h3a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-3"/><path d="M12 2v20"/></svg>`,
  csharp: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5v14"/><path d="M14 5v14"/><path d="M5 10h14"/><path d="M5 14h14"/><path d="M5 5l14 14"/></svg>`,
  dotnet: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>`,
  git: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v6"/><path d="M12 16v6"/><path d="M2 12h6"/><path d="M16 12h6"/></svg>`,
  dart: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M21 3L3 21"/><path d="M12 3l9 9-9 9"/></svg>`,
  windows: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>`,
  generic: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>`,
};

function certIcon(name: string, issuer: string): string {
  const t = (name + " " + issuer).toLowerCase();
  if (t.includes("python") || t.includes("ciencia de la computación")) return "python";
  if (t.includes("c#") || t.includes("c sharp") || t.includes("poo") || t.includes("clean code") || t.includes("solid") || t.includes("linq")) return "csharp";
  if (t.includes(".net") || t.includes("net")) return "dotnet";
  if (t.includes("dart")) return "dart";
  if (t.includes("git")) return "git";
  if (t.includes("windows") || t.includes("prework")) return "windows";
  return "generic";
}
---

<Section className={Astro.props.className} title="Education">
	<ul class="space-y-4 py-3 print:space-y-0">
		{
			education.map(({ institution, startDate, endDate, area, url }) => {
				const startYear = yearOf(startDate);
				const endYear = endDate != null ? yearOf(endDate) : "Actual";
				const years = `${startYear} - ${endYear}`;

				return (
					<div class="flex items-baseline">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden">
							<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
							<path d="M22 10v6" />
							<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
						</svg>
						<div class="relative w-full items-baseline justify-between gap-2">
							<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
								<a target="_blank" class="hover:text-skin-hue group flex items-center gap-[6px] decoration-dotted underline-offset-[5px] hover:underline" href={url}>
									{institution}
								</a>
							</h3>
							<div class="text-sm text-skin-muted">{area}</div>
							<time class="right-0 top-0 text-xs text-skin-muted md:absolute md:block">{years}</time>
						</div>
					</div>
				);
			})
		}
	</ul>

	{certificates.length > 0 && (
		<div class="mt-1">
			<h4 class="text-xs font-semibold text-skin-muted mb-1.5 tracking-wider uppercase">Certificates</h4>
			<div class="carousel-wrap">
				<div class="carousel-track" style={`--speed: ${Math.max(15, certificates.length * 2)}s`}>
					<div class="carousel-group">
						{certificates.map(({ name, date, issuer, url }) => {
							const year = yearOf(date);
							return (
								<a href={url} target="_blank" class="cert-card">
									<span class="cert-icon" set:html={icons[certIcon(name, issuer)]} />
									<div class="cert-info">
										<span class="text-sm font-medium">{name}</span>
										<span class="text-xs text-skin-muted">{issuer} · {year}</span>
									</div>
								</a>
							);
						})}
					</div>
					<div class="carousel-group" aria-hidden="true">
						{certificates.map(({ name, date, issuer, url }) => {
							const year = yearOf(date);
							return (
								<a href={url} target="_blank" class="cert-card" tabindex="-1">
									<span class="cert-icon" set:html={icons[certIcon(name, issuer)]} />
									<div class="cert-info">
										<span class="text-sm font-medium">{name}</span>
										<span class="text-xs text-skin-muted">{issuer} · {year}</span>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			</div>
		</div>
	)}
</Section>

<style is:global>
  .carousel-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    padding: 4px 0;
  }

  .carousel-track {
    display: flex;
    width: max-content;
    gap: 8px;
    animation: cert-scroll var(--speed, 30s) linear infinite;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  .carousel-group {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  @keyframes cert-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: border-color 0.15s, background 0.15s;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cert-card:hover {
    border-color: rgba(var(--color), 0.2);
    background: rgba(var(--color), 0.04);
  }

  .cert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: rgba(var(--color), 0.08);
    color: rgba(var(--color), 0.7);
    flex-shrink: 0;
  }

  .cert-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  @media (max-width: 480px) {
    .carousel-wrap {
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .cert-card {
      gap: 4px;
      padding: 4px 6px;
      border-radius: 4px;
    }

    .cert-icon {
      width: 18px;
      height: 18px;
    }

    .cert-info .text-sm {
      font-size: 0.7rem !important;
    }

    .cert-info .text-xs {
      font-size: 0.6rem !important;
    }
  }
</style>
