---
import Section from "../Section.astro";
import { education, certificates } from "@cv";
import { yearOf } from "@/lib/date";

interface Props {
	className?: string;
}

const icons: Record<string, string> = {
	python: `<path d="M9 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3"/><path d="M15 5h3a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-3"/><path d="M12 2v20"/>`,
	csharp: `<path d="M10 5v14"/><path d="M14 5v14"/><path d="M5 10h14"/><path d="M5 14h14"/>`,
	dotnet: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/>`,
	git: `<circle cx="12" cy="12" r="4"/><path d="M12 2v6"/><path d="M12 16v6"/><path d="M2 12h6"/><path d="M16 12h6"/>`,
	dart: `<path d="M12 3l9 9-9 9-9-9z"/>`,
	windows: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/>`,
	language: `<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>`,
	award: `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>`,
	generic: `<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/>`,
};

function certIcon(name: string, issuer: string): string {
	const t = `${name} ${issuer}`.toLowerCase();
	if (t.includes("python")) return "python";
	if (/c#|poo|clean code|solid|linq/.test(t)) return "csharp";
	if (t.includes(".net")) return "dotnet";
	if (t.includes("dart")) return "dart";
	if (t.includes("git")) return "git";
	if (t.includes("windows")) return "windows";
	if (t.includes("english") || t.includes("icpna")) return "language";
	if (t.includes("challenge") || t.includes("hackathon")) return "award";
	return "generic";
}

const sortedCertificates = [...certificates].sort((a, b) => b.date.localeCompare(a.date));
const isPdf = (url: string) => url.toLowerCase().endsWith(".pdf");
---

<Section className={Astro.props.className} title="Educación">
	<ul class="flex flex-col gap-5 print:gap-2">
		{
			education.map(({ institution, startDate, endDate, area, studyType, url }) => {
				const years = `${yearOf(startDate)} – ${endDate ? yearOf(endDate) : "Actualidad"}`;

				return (
					<li class="flex gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 hidden size-5 shrink-0 text-skin-hue sm:block print:hidden" aria-hidden="true">
							<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
							<path d="M22 10v6" />
							<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
						</svg>
						<div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
							<div class="min-w-0">
								<h3 class="font-medium">
									{url ? (
										<a class="decoration-dotted underline-offset-4 hover:text-skin-hue hover:underline" href={url} target="_blank" rel="noopener noreferrer">
											{institution}
										</a>
									) : (
										institution
									)}
								</h3>
								<p>{[studyType, area].filter(Boolean).join(" · ")}</p>
							</div>
							<p class="shrink-0 text-xs tabular-nums">{years}</p>
						</div>
					</li>
				);
			})
		}
	</ul>

	{
		sortedCertificates.length > 0 && (
			<div class="certs mt-6 print:mt-3" data-certs>
				<div class="mb-2 flex items-center justify-between gap-2">
					<h3 id="certs-title" class="text-xs font-semibold uppercase tracking-wider text-skin-muted">
						Certificados <span class="font-normal">({sortedCertificates.length})</span>
					</h3>
					<div class="max-sm:hidden print:hidden" data-certs-controls hidden>
						<div class="flex gap-1">
						<button type="button" class="certs-nav" data-dir="-1" aria-controls="certs-track" aria-label="Certificados anteriores">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
						</button>
						<button type="button" class="certs-nav" data-dir="1" aria-controls="certs-track" aria-label="Certificados siguientes">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
						</button>
						</div>
					</div>
				</div>

				<ul id="certs-track" class="certs-track" tabindex="0" aria-labelledby="certs-title">
					{sortedCertificates.map(({ name, date, issuer, url }) => (
						<li class="cert-item">
							<a href={url} target="_blank" rel="noopener noreferrer" class="cert-card">
								<span class="cert-icon" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[certIcon(name, issuer)]} />
								</span>
								<span class="flex min-w-0 flex-col">
									<span class="cert-name">{name}</span>
									<span class="text-xs text-skin-muted">
										{issuer} · {yearOf(date)}{" "}
										{isPdf(url) && <span class="cert-badge">PDF</span>}
									</span>
								</span>
								<span class="sr-only">(se abre en una pestaña nueva)</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}
</Section>

<script>
	document.querySelectorAll<HTMLElement>("[data-certs]").forEach((root) => {
		const track = root.querySelector<HTMLElement>(".certs-track");
		const controls = root.querySelector<HTMLElement>("[data-certs-controls]");
		const buttons = root.querySelectorAll<HTMLButtonElement>(".certs-nav");
		if (!track || !controls) return;

		const update = () => {
			const max = track.scrollWidth - track.clientWidth;
			controls.hidden = max <= 1;
			buttons.forEach((btn) => {
				const dir = Number(btn.dataset.dir);
				btn.disabled = dir < 0 ? track.scrollLeft <= 1 : track.scrollLeft >= max - 1;
			});
		};

		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth * 0.85, behavior: reduce ? "auto" : "smooth" });
			});
		});

		track.addEventListener("scroll", update, { passive: true });
		new ResizeObserver(update).observe(track);
		update();
	});
</script>

<style>
	@reference "../../styles/global.css";

	.certs-track {
		@apply relative -mx-1 flex snap-x snap-mandatory scroll-px-1 gap-2 overflow-x-auto scroll-smooth px-1 pb-3 pt-1 outline-hidden motion-reduce:scroll-auto;
		scrollbar-width: thin;
		scrollbar-color: rgb(var(--muted)) transparent;
		overscroll-behavior-x: contain;
	}

	.certs-track:focus-visible {
		@apply rounded-md ring-2 ring-skin-hue;
	}

	.cert-item {
		@apply w-[15rem] shrink-0 snap-start sm:w-[16.5rem];
	}

	.cert-card {
		@apply flex h-full items-start gap-2.5 rounded-lg bg-skin-button-muted/50 p-3 ring-1 ring-skin-muted transition-colors hover:ring-skin-hue/60 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-skin-hue;
	}

	.cert-icon {
		@apply flex size-8 shrink-0 items-center justify-center rounded-md bg-skin-hue/10 text-skin-hue;
	}

	.cert-icon :global(svg) {
		@apply size-4;
	}

	.cert-name {
		@apply text-sm font-medium leading-snug text-skin-base;
	}

	.cert-badge {
		@apply ml-1 rounded-sm border border-skin-hue/30 px-1 text-[0.625rem] font-semibold uppercase tracking-wide text-skin-hue;
	}

	.certs-nav {
		@apply inline-flex size-8 items-center justify-center rounded-md text-skin-muted ring-1 ring-skin-muted transition-colors hover:text-skin-hue disabled:cursor-not-allowed disabled:opacity-40;
	}

	@media print {
		.certs-track {
			@apply m-0 flex-col gap-0.5 overflow-visible p-0;
		}

		.cert-item {
			@apply w-auto;
		}

		.cert-card {
			@apply bg-transparent p-0 ring-0;
		}

		.cert-icon,
		.cert-badge {
			@apply hidden;
		}
	}
</style>
