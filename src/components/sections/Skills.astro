---
import Section from "../Section.astro";
import SkillTag from "@/components/SkillTag.astro";
import { skills } from "@cv";

interface Props {
	className?: string;
}

const CATEGORY_ORDER = ["Lenguajes", "Backend", "Frontend", "DevOps", "Herramientas"];

const categories = [...new Set([...CATEGORY_ORDER, ...skills.map((s) => s.category)])]
	.map((category) => ({ category, items: skills.filter((s) => s.category === category) }))
	.filter(({ items }) => items.length > 0);
---

<Section className={Astro.props.className} title="Skills">
	<dl class="grid gap-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-3">
		{
			categories.map(({ category, items }) => (
				<>
					<dt class="text-sm font-medium text-skin-muted sm:pt-0.5">{category}</dt>
					<dd class="-mt-2 sm:mt-0">
						<ul class="flex flex-wrap gap-1.5" aria-label={category}>
							{items.map(({ name }) => (
								<SkillTag name={name} />
							))}
						</ul>
					</dd>
				</>
			))
		}
	</dl>
</Section>
