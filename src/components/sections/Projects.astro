---
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "../Section.astro";

import { projects } from "@cv";

const limit = Astro.props.limit ?? 2;
const showAll = Astro.props.showAll ?? false;
const displayed = showAll ? projects : projects.slice(0, limit);

const categoryOrder = ["Full Stack", "Frontend", "Entorno", "Aprendizaje", "Académico"];

function groupByCategory<T extends { category?: string }>(items: T[]): Map<string, T[]> {
	const map = new Map<string, T[]>();
	for (const item of items) {
		const cat = item.category ?? "Otros";
		if (!map.has(cat)) map.set(cat, []);
		map.get(cat)!.push(item);
	}
	return map;
}

function sortedGroups<T extends { category?: string }>(items: T[]): [string, T[]][] {
	const grouped = groupByCategory(items);
	const entries = Array.from(grouped.entries());
	entries.sort((a, b) => {
		const ai = categoryOrder.indexOf(a[0]);
		const bi = categoryOrder.indexOf(b[0]);
		return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
	});
	return entries;
}

const categoryGroups = showAll ? sortedGroups(displayed) : null;
const allCategories = showAll ? categoryGroups!.map(([c]) => c) : [];
---

<Section className={Astro.props.className}>
	{
		!showAll ? (
			<a href="/projects" class="group relative flex w-full items-center gap-2 pb-4 text-3xl print:gap-1 print:pb-0 print:text-xl text-skin-base no-underline transition hover:text-skin-hue">
				Projects
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
		) : (
			<>
				<h3 class="relative flex w-full items-center gap-3 pb-4 text-3xl print:gap-1 print:pb-0 print:text-xl">Projects</h3>

				<div id="project-filter" class="no-print mb-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar proyectos por categoría">
					<button type="button" data-filter="all" aria-pressed="true" class="filter-btn inline-flex min-h-10 items-center rounded-full border border-skin-muted px-4 text-sm text-skin-muted transition hover:border-skin-hue hover:text-skin-hue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue">Todos</button>
					{allCategories.map((cat) => (
						<button type="button" data-filter={cat} aria-pressed="false" class="filter-btn inline-flex min-h-10 items-center rounded-full border border-skin-muted px-4 text-sm text-skin-muted transition hover:border-skin-hue hover:text-skin-hue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue">{cat}</button>
					))}
				</div>

				<div id="project-groups">
					{categoryGroups!.map(([category, items]) => (
						<div data-category={category} class="mb-8">
							<h4 class="mb-3 flex items-center gap-2 text-lg font-semibold text-skin-base">
								<span class="text-skin-hue">{category}</span>
								<span class="h-px flex-1 bg-skin-muted/30"></span>
							</h4>
							<div class="grid grid-cols-1 gap-3 md:grid-cols-2 print:flex print:flex-col">
								{items.map((item) => (
									<ProjectCard {...item} />
								))}
							</div>
						</div>
					))}
				</div>
			</>
		)
	}
	{
		!showAll && (
			<div class="grid grid-cols-1 gap-3 md:grid-cols-2 print:flex print:flex-col">
				{displayed.map((item) => (
					<ProjectCard {...item} />
				))}
			</div>
		)
	}
	{!showAll && projects.length > limit && (
		<a href="/projects" class="mt-2 inline-flex items-center gap-1 text-sm text-skin-muted transition hover:text-skin-hue">
			Ver todos los proyectos ({projects.length})
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
		</a>
	)}
</Section>

<script>
	const filterBtns = document.querySelectorAll("#project-filter .filter-btn");
	const groups = document.querySelectorAll("#project-groups [data-category]");

	function applyFilter(category: string) {
		filterBtns.forEach((btn) => {
			const isActive = btn.getAttribute("data-filter") === category;
			btn.setAttribute("aria-pressed", String(isActive));
		});
		groups.forEach((group) => {
			const match = category === "all" || group.getAttribute("data-category") === category;
			group.classList.toggle("hidden", !match);
		});
	}

	filterBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const cat = btn.getAttribute("data-filter") ?? "all";
			applyFilter(cat);
		});
	});

	applyFilter("all");
</script>

<style>
	.filter-btn[aria-pressed="true"] {
		@apply border-skin-hue bg-skin-hue/10 text-skin-hue;
	}
	.hidden {
		display: none !important;
	}
</style>
