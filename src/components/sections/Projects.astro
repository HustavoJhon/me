---
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "../Section.astro";

import { projects } from "@cv";

const limit = Astro.props.limit ?? 2;
const showAll = Astro.props.showAll ?? false;
const displayed = showAll ? projects : projects.slice(0, limit);

const categoryOrder = ["Full Stack", "Frontend", "Entorno", "Aprendizaje", "Académico"];

function groupByCategory<T extends { category?: string }>(items: T[]): Map<string, T[]> {
	const map = new Map<string, T[]>();
	for (const item of items) {
		const cat = item.category ?? "Otros";
		if (!map.has(cat)) map.set(cat, []);
		map.get(cat)!.push(item);
	}
	return map;
}

function sortedGroups<T extends { category?: string }>(items: T[]): [string, T[]][] {
	const grouped = groupByCategory(items);
	const entries = Array.from(grouped.entries());
	entries.sort((a, b) => {
		const ai = categoryOrder.indexOf(a[0]);
		const bi = categoryOrder.indexOf(b[0]);
		return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
	});
	return entries;
}

const categoryGroups = showAll ? sortedGroups(displayed) : null;
const allCategories = showAll ? categoryGroups!.map(([c]) => c) : [];
---

<Section className={Astro.props.className} title="Projects" titleHref={showAll ? undefined : "/projects"} headingLevel={showAll ? 1 : 2}>
	{
		showAll ? (
			<>
				<div id="project-filter" class="no-print flex flex-wrap gap-2" role="group" aria-label="Filtrar proyectos por categoría">
					<button type="button" data-filter="all" aria-pressed="true" class="filter-btn">
						Todos
					</button>
					{allCategories.map((cat) => (
						<button type="button" data-filter={cat} aria-pressed="false" class="filter-btn">
							{cat}
						</button>
					))}
				</div>

				<div id="project-groups" class="flex flex-col gap-10">
					{categoryGroups!.map(([category, items]) => (
						<section data-category={category} aria-label={category}>
							<h2 class="mb-4 flex items-center gap-3 text-lg font-semibold text-skin-hue">
								{category}
								<span class="h-px flex-1 bg-skin-muted" aria-hidden="true" />
							</h2>
							<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 print:flex print:flex-col">
								{items.map((item) => (
									<ProjectCard {...item} />
								))}
							</div>
						</section>
					))}
				</div>
			</>
		) : (
			<>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 print:flex print:flex-col">
					{displayed.map((item) => (
						<ProjectCard {...item} />
					))}
				</div>
				{projects.length > limit && (
					<a href="/projects" class="inline-flex w-fit items-center gap-1 text-sm text-skin-muted transition-colors hover:text-skin-hue">
						Ver todos los proyectos ({projects.length})
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				)}
			</>
		)
	}
</Section>

<script>
	const filterBtns = document.querySelectorAll("#project-filter .filter-btn");
	const groups = document.querySelectorAll("#project-groups [data-category]");

	function applyFilter(category: string) {
		filterBtns.forEach((btn) => {
			const isActive = btn.getAttribute("data-filter") === category;
			btn.setAttribute("aria-pressed", String(isActive));
		});
		groups.forEach((group) => {
			const match = category === "all" || group.getAttribute("data-category") === category;
			group.classList.toggle("hidden", !match);
		});
	}

	filterBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const cat = btn.getAttribute("data-filter") ?? "all";
			applyFilter(cat);
		});
	});

	applyFilter("all");
</script>

<style>
	@reference "../../styles/global.css";

	.filter-btn {
		@apply inline-flex min-h-10 items-center rounded-full border border-skin-muted px-4 text-sm text-skin-muted transition-colors hover:border-skin-hue hover:text-skin-hue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skin-hue;
	}

	.filter-btn[aria-pressed="true"] {
		@apply border-skin-hue bg-skin-hue/10 text-skin-hue;
	}
	.hidden {
		display: none !important;
	}
</style>
