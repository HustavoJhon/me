---
import Section from "../Section.astro";
import stored from "@/data/contributions.json";
import { getContributions } from "@/lib/contributions/load";
import { buildCalendar } from "@/lib/contributions/calendar";
import type { StoredSnapshot } from "@/lib/contributions/snapshot";

interface Props {
	className?: string;
}

const { username, years } = await getContributions(stored as StoredSnapshot);

const MONTHS = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
const MONTHS_LONG = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const WEEKDAYS = ["", "Lun", "", "Mié", "", "Vie", ""];

// 1869 stays "1869"; grouping only from five digits (18,690), as in Spanish typography.
const formatCount = (n: number) => (n >= 10_000 ? n.toLocaleString("es-PE") : String(n));
const shortDate = new Intl.DateTimeFormat("es-PE", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const plural = (n: number) => `${formatCount(n)} ${n === 1 ? "contribución" : "contribuciones"}`;
const longDay = (iso: string) => `${Number(iso.slice(8, 10))} de ${MONTHS_LONG[Number(iso.slice(5, 7)) - 1]}`;

// Days after the data was fetched have not happened yet for that snapshot.
const panels = years.map((data) => {
	const layout = buildCalendar(data.year);
	const lastKnownDay = data.fetchedAt.slice(0, 10);
	const monthly = MONTHS_LONG.map((name, m) => ({
		name,
		count: data.days.filter((d) => Number(d.date.slice(5, 7)) - 1 === m).reduce((sum, d) => sum + d.count, 0),
	}));
	const busiest = data.days.reduce((best, d) => (d.count > best.count ? d : best), data.days[0]);
	return { ...data, layout, lastKnownDay, monthly, busiest };
});

const selected = panels[0];
const profileUrl = `https://github.com/${username}`;
---

<Section className={Astro.props.className} title="Contributions">
	{
		!selected ? (
			<p>No hay datos de contribuciones disponibles en este momento.</p>
		) : (
			<div class="contrib" data-contrib>
				<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
					<p class="text-base font-semibold text-skin-base" aria-live="polite" data-contrib-total>
						{plural(selected.total)} en {selected.year}
					</p>

					<div class="contrib-years" role="tablist" aria-label="Año">
						{panels.map((p) => (
							<button
								type="button"
								role="tab"
								id={`contrib-tab-${p.year}`}
								aria-controls={`contrib-panel-${p.year}`}
								aria-selected={p === selected ? "true" : "false"}
								tabindex={p === selected ? 0 : -1}
								data-year={p.year}
								data-total={`${plural(p.total)} en ${p.year}`}
								class="contrib-year"
							>
								{p.year}
							</button>
						))}
					</div>
				</div>

				{panels.map((p) => (
					<div role="tabpanel" id={`contrib-panel-${p.year}`} aria-labelledby={`contrib-tab-${p.year}`} hidden={p !== selected} class="contrib-panel" data-year={p.year} data-last-day={p.lastKnownDay}>
						<div class="contrib-scroll">
							<div class="contrib-graph" style={`--weeks: ${p.layout.weeks}`}>
								<div class="contrib-months" aria-hidden="true">
									{p.layout.monthLabels.map(({ month, column }) => (
										<span style={`grid-column: ${column + 2}`}>{MONTHS[month]}</span>
									))}
								</div>
								<div
									class="contrib-days"
									tabindex="0"
									role="group"
									aria-roledescription="calendario"
									aria-label={`Contribuciones diarias en ${p.year}. Usa las flechas para recorrer los días.`}
									data-days
								>
									{WEEKDAYS.map((label) => (
										<span class="contrib-wd" aria-hidden="true">
											{label}
										</span>
									))}
									{Array.from({ length: p.layout.offset }, () => (
										<i data-pad />
									))}
									{p.days.map(({ date, count, level }) =>
										date > p.lastKnownDay ? <i data-future /> : <i data-l={level || undefined} data-c={count || undefined} />,
									)}
								</div>
							</div>
						</div>

						<div class="sr-only">
							<p>
								{plural(p.total)} en {p.year}.
								{p.busiest.count > 0 && ` Día con más actividad: ${longDay(p.busiest.date)}, con ${plural(p.busiest.count)}.`}
							</p>
							<table>
								<caption>Contribuciones por mes en {p.year}</caption>
								<thead>
									<tr>
										<th scope="col">Mes</th>
										<th scope="col">Contribuciones</th>
									</tr>
								</thead>
								<tbody>
									{p.monthly.map(({ name, count }) => (
										<tr>
											<th scope="row">{name}</th>
											<td>{count}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>

						<div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-skin-muted">
							<p class="text-xs">
								Datos de{" "}
								<a href={profileUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:text-skin-hue">
									GitHub
								</a>{" "}
								al <time datetime={p.fetchedAt}>{shortDate.format(new Date(p.fetchedAt))}</time>
							</p>
							<div class="flex items-center gap-1" aria-hidden="true">
								<span class="mr-1">Menos</span>
								{[0, 1, 2, 3, 4].map((l) => (
									<i class="contrib-legend" data-l={l || undefined} />
								))}
								<span class="ml-1">Más</span>
							</div>
						</div>
					</div>
				))}

				<div class="contrib-tip" role="tooltip" hidden data-contrib-tip></div>
				<p class="sr-only" aria-live="polite" data-contrib-live></p>
			</div>
		)
	}
</Section>

<script>
	const MONTHS_LONG = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
	const formatCount = (n: number) => (n >= 10_000 ? n.toLocaleString("es-PE") : String(n));

	const describe = (cell: HTMLElement, iso: string) => {
		const [y, m, d] = iso.split("-").map(Number);
		const day = `${d} de ${MONTHS_LONG[m - 1]} de ${y}`;
		if (cell.hasAttribute("data-future")) return `${day}: sin datos todavía`;
		const count = Number(cell.dataset.c ?? 0);
		if (count === 0) return `Sin contribuciones el ${day}`;
		return `${formatCount(count)} ${count === 1 ? "contribución" : "contribuciones"} el ${day}`;
	};

	const isoFromIndex = (year: number, index: number) => new Date(Date.UTC(year, 0, 1 + index)).toISOString().slice(0, 10);

	document.querySelectorAll<HTMLElement>("[data-contrib]").forEach((root) => {
		const tip = root.querySelector<HTMLElement>("[data-contrib-tip]")!;
		const live = root.querySelector<HTMLElement>("[data-contrib-live]")!;
		const totalLabel = root.querySelector<HTMLElement>("[data-contrib-total]")!;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

		// Day cells per panel, in date order (excludes weekday labels and padding).
		const cellsOf = new Map<HTMLElement, HTMLElement[]>();
		const indexOf = new WeakMap<HTMLElement, number>();
		for (const panel of panels) {
			const cells = [...panel.querySelectorAll<HTMLElement>("[data-days] > i:not([data-pad])")];
			cells.forEach((cell, i) => indexOf.set(cell, i));
			cellsOf.set(panel, cells);
		}

		const showTip = (panel: HTMLElement, cell: HTMLElement) => {
			const year = Number(panel.dataset.year);
			tip.textContent = describe(cell, isoFromIndex(year, indexOf.get(cell)!));
			tip.hidden = false;
			const host = root.getBoundingClientRect();
			const box = cell.getBoundingClientRect();
			const width = tip.offsetWidth;
			const left = Math.min(Math.max(box.left + box.width / 2 - host.left - width / 2, 0), host.width - width);
			tip.style.left = `${left}px`;
			tip.style.top = `${box.top - host.top - tip.offsetHeight - 6}px`;
			return tip.textContent;
		};

		const hideTip = () => {
			tip.hidden = true;
		};

		const scrollToRecent = (panel: HTMLElement) => {
			const scroller = panel.querySelector<HTMLElement>(".contrib-scroll")!;
			if (scroller.scrollWidth <= scroller.clientWidth) return;
			const cells = cellsOf.get(panel)!;
			const last = cells.findLast((c) => !c.hasAttribute("data-future")) ?? cells.at(-1)!;
			scroller.scrollLeft = last.offsetLeft - scroller.clientWidth + last.offsetWidth * 4;
		};

		const select = (tab: HTMLButtonElement, focus = false) => {
			for (const t of tabs) {
				const active = t === tab;
				t.setAttribute("aria-selected", String(active));
				t.tabIndex = active ? 0 : -1;
			}
			for (const panel of panels) {
				panel.hidden = panel.id !== tab.getAttribute("aria-controls");
				if (!panel.hidden) scrollToRecent(panel);
			}
			totalLabel.textContent = tab.dataset.total ?? "";
			hideTip();
			if (focus) tab.focus();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => select(tab));
			tab.addEventListener("keydown", (event) => {
				const moves: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
				if (!(event.key in moves)) return;
				event.preventDefault();
				select(tabs[(moves[event.key] + tabs.length) % tabs.length], true);
			});
		});

		for (const panel of panels) {
			const grid = panel.querySelector<HTMLElement>("[data-days]")!;
			const cells = cellsOf.get(panel)!;
			let active = -1;

			const activate = (index: number) => {
				cells[active]?.classList.remove("is-active");
				active = Math.max(0, Math.min(cells.length - 1, index));
				const cell = cells[active];
				cell.classList.add("is-active");
				cell.scrollIntoView({ block: "nearest", inline: "nearest" });
				live.textContent = showTip(panel, cell);
			};

			grid.addEventListener("pointerover", (event) => {
				const cell = (event.target as HTMLElement).closest<HTMLElement>("i");
				if (cell && indexOf.has(cell)) showTip(panel, cell);
			});
			grid.addEventListener("pointerleave", () => {
				if (document.activeElement !== grid) hideTip();
			});

			grid.addEventListener("focus", () => {
				if (active < 0) {
					const lastKnown = cells.findLastIndex((c) => !c.hasAttribute("data-future"));
					active = lastKnown < 0 ? 0 : lastKnown;
				}
				activate(active);
			});
			grid.addEventListener("blur", () => {
				cells[active]?.classList.remove("is-active");
				hideTip();
			});
			grid.addEventListener("keydown", (event) => {
				const moves: Record<string, number> = {
					ArrowUp: active - 1,
					ArrowDown: active + 1,
					ArrowLeft: active - 7,
					ArrowRight: active + 7,
					Home: 0,
					End: cells.length - 1,
				};
				if (!(event.key in moves)) {
					if (event.key === "Escape") hideTip();
					return;
				}
				event.preventDefault();
				activate(moves[event.key]);
			});
		}

		window.addEventListener("resize", hideTip, { passive: true });
		root.querySelectorAll(".contrib-scroll").forEach((s) => s.addEventListener("scroll", hideTip, { passive: true }));
		const initial = panels.find((p) => !p.hidden);
		if (initial) scrollToRecent(initial);
	});
</script>

<style>
	.contrib {
		--cell-min: 11px;
		--cell-max: 15px;
		--gap: 3px;
		--label-w: 1.75rem;
		--c0: rgb(var(--color-button-muted));
		--c4: rgb(var(--color));
		position: relative;
	}

	:global(.dark) .contrib {
		--c0: rgb(var(--muted));
	}

	@media (min-width: 640px) {
		.contrib {
			--cell-min: 7px;
		}
	}

	.contrib-years {
		@apply -mx-1 flex max-w-full gap-1 overflow-x-auto px-1 py-1;
		scrollbar-width: none;
	}

	.contrib-year {
		@apply inline-flex min-h-9 shrink-0 items-center rounded-md px-3 text-sm tabular-nums text-skin-muted transition-colors hover:bg-skin-hue/10 hover:text-skin-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-skin-hue;
	}

	.contrib-year[aria-selected="true"] {
		@apply bg-skin-hue/15 font-semibold text-skin-base;
	}

	.contrib-panel {
		@apply mt-3 rounded-lg p-3 ring-1 ring-skin-muted sm:p-4;
	}

	@media (prefers-reduced-motion: no-preference) {
		.contrib-panel:not([hidden]) {
			animation: contrib-in 0.25s ease-out;
		}
	}

	@keyframes contrib-in {
		from {
			opacity: 0;
		}
	}

	.contrib-scroll {
		@apply relative overflow-x-auto pb-1;
		scrollbar-width: thin;
		scrollbar-color: rgb(var(--muted)) transparent;
	}

	.contrib-graph {
		--cols: var(--label-w) repeat(var(--weeks), minmax(var(--cell-min), var(--cell-max)));
		display: grid;
		gap: 4px;
		/* Fluid cells between --cell-min and --cell-max; scroll only below the minimum. */
		width: 100%;
		min-width: min-content;
	}

	.contrib-months,
	.contrib-days {
		display: grid;
		grid-template-columns: var(--cols);
		column-gap: var(--gap);
	}

	.contrib-months {
		@apply text-[0.6875rem] leading-none text-skin-muted;
	}

	.contrib-months span {
		@apply whitespace-nowrap;
	}

	.contrib-days {
		grid-template-rows: repeat(7, auto);
		grid-auto-flow: column;
		row-gap: var(--gap);
		@apply rounded outline-none;
	}

	/* Keyboard focus: highlight the panel border plus the active day (an outline would cover month labels). */
	.contrib-panel:has([data-days]:focus-visible) {
		@apply ring-2 ring-skin-hue;
	}

	.contrib-wd {
		@apply sticky left-0 z-[1] flex items-center bg-skin-fill pr-1 text-[0.6875rem] leading-none text-skin-muted;
	}

	.contrib-days i,
	.contrib-legend {
		display: block;
		aspect-ratio: 1;
		border-radius: 2px;
		background: var(--c0);
		outline: 1px solid rgb(0 0 0 / 0.05);
		outline-offset: -1px;
	}

	:global(.dark) .contrib-days i,
	:global(.dark) .contrib-legend {
		outline-color: rgb(255 255 255 / 0.04);
	}

	.contrib-legend {
		width: 10px;
	}

	.contrib [data-l="1"] {
		background: color-mix(in srgb, var(--c4) 30%, var(--c0));
	}

	.contrib [data-l="2"] {
		background: color-mix(in srgb, var(--c4) 52%, var(--c0));
	}

	.contrib [data-l="3"] {
		background: color-mix(in srgb, var(--c4) 76%, var(--c0));
	}

	.contrib [data-l="4"] {
		background: var(--c4);
	}

	.contrib-days [data-pad] {
		visibility: hidden;
	}

	.contrib-days [data-future] {
		background: transparent;
		outline: 1px dashed rgba(var(--color-text-muted), 0.45);
	}

	.contrib-days i.is-active {
		outline: 2px solid rgb(var(--color-text-base));
		outline-offset: 1px;
		position: relative;
		z-index: 1;
	}

	.contrib-tip {
		@apply pointer-events-none absolute left-0 top-0 z-20 max-w-[16rem] whitespace-nowrap rounded-md bg-skin-button-accent px-2.5 py-1.5 text-xs text-skin-inverted shadow-lg;
	}
</style>
