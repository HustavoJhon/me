---
import Section from "../Section.astro";
import SkillTag from "@/components/SkillTag.astro";
import { work } from "@cv";
import { yearOf } from "@/lib/date";

interface Props {
	className?: string;
}
---

<Section className={Astro.props.className} title="Experience">
	<ol class="flex flex-col gap-10 print:gap-3">
		{
			work.map(({ name, startDate, endDate, position, summary, responsibilities, achievements, url, skills, location, location_type }) => {
				const startYear = yearOf(startDate);
				const endYear = endDate != null ? yearOf(endDate) : "Presente";
				const place = [location, location_type].filter(Boolean).join(" · ");

				return (
					<li class="grid gap-x-6 gap-y-2 sm:grid-cols-[6.5rem_minmax(0,1fr)] print:grid-cols-1 print:gap-1">
						<p class="text-xs font-semibold uppercase tracking-wide text-skin-muted sm:pt-1.5">
							<time datetime={startDate}>{startYear}</time> – {endDate ? <time datetime={endDate}>{endYear}</time> : endYear}
						</p>

						<div class="relative border-l border-skin-muted pl-5 sm:pl-6 print:border-none print:pl-0">
							<span class="absolute -left-[5px] top-2 size-[9px] rounded-full bg-skin-hue ring-4 ring-skin-fill print:hidden" aria-hidden="true" />

							<h3 class="text-lg leading-snug print:text-base">
								{position}{" "}
								<span class="text-skin-muted">@</span>{" "}
								{url ? (
									<a class="group/link inline-flex items-baseline gap-0.5 text-skin-hue hover:underline" href={url} target="_blank" rel="noopener noreferrer">
										{name}
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 shrink-0 transition-transform group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5 motion-reduce:transition-none print:hidden" aria-hidden="true">
											<path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
										</svg>
										<span class="sr-only">(se abre en una pestaña nueva)</span>
									</a>
								) : (
									<span>{name}</span>
								)}
							</h3>
							{place && <p class="mt-0.5 text-xs">{place}</p>}

							<div class="mt-4 flex flex-col gap-4 text-sm print:mt-1 print:gap-1 print:text-xs">
								{summary && <p class="text-skin-base">{summary}</p>}

								{responsibilities?.length > 0 && (
									<div>
										<h4 class="mb-1.5 text-sm font-medium">Responsabilidades</h4>
										<ul class="bullets">
											{responsibilities.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								)}

								{achievements?.length > 0 && (
									<div>
										<h4 class="mb-1.5 text-sm font-medium">Logros</h4>
										<ul class="bullets">
											{achievements.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								)}

								{skills?.length > 0 && (
									<ul class="flex flex-wrap gap-1.5 print:hidden" aria-label="Tecnologías utilizadas">
										{skills.map((skill) => (
											<SkillTag name={skill} />
										))}
									</ul>
								)}
							</div>
						</div>
					</li>
				);
			})
		}
	</ol>
</Section>

<style>
	@reference "../../styles/global.css";

	.bullets {
		@apply ml-4 flex list-disc flex-col gap-1.5 text-skin-muted;
	}

	.bullets li::marker {
		@apply text-skin-hue;
	}
</style>
