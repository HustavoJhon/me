---
import Theme from "@/icons/themeSwitch.astro";
---

<div class="no-print inline-flex items-center">
	<div class="group/theme flex items-center gap-2">
		<label for="themeSwitch" class="flex items-center gap-1 text-sm font-medium leading-6 text-skin-base transition-transform ease-in-out group-hover/theme:rotate-45"><Theme /><span class="sr-only">Tema</span></label>
		<select id="themeSwitch" name="themeSwitch" class="focus:ring-skin-hue ring-skin-muted block min-h-10 w-full rounded-md border-0 bg-skin-fill py-1.5 pl-3 pr-10 text-sm text-skin-base ring-1 ring-inset focus:ring-2">
			<option value="system">Sistema</option>
			<option value="dark">Oscuro</option>
			<option value="light">Claro</option>
		</select>
	</div>

	<script>
		const select = document.getElementById("themeSwitch") as HTMLSelectElement;
		try {
			select.value = localStorage.getItem("theme") ?? "system";
		} catch {
			select.value = "system";
		}

		select.addEventListener("change", () => {
			try {
				localStorage.setItem("theme", select.value);
			} catch {
				// Storage unavailable (private mode): theme still applies for this page view.
			}
			window.applyTheme?.();
		});
	</script>
</div>
